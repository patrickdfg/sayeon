  [
   "<극과 극의 삶>"
  ],
  [
   "극적인 지상 천국",
   "극적인 지옥 고통",
   "공전(公轉)하며",
   "천 년 역사 뜻을",
   "이루며 살아간다"
  ],
  [
   "행하면",
   "이기고",
   "마음 천국 육의 천국",
   "이루며 간다",
   "이상의 세계다"
  ],
  [
   "이기고 이기고",
   "나는 이기리로다",
   "나와 같이 끝까지 가는 자",
   "다 이기리로다"
  ]
 ]
